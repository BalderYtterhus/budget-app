{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Ambient types shipped with Vite: import.meta.env and the CSS/asset
    // module declarations. Without these, client.ts and main.tsx error even
    // though both work at runtime. Not a new dependency — vite is installed.
    "types": ["vite/client"],
    // No baseUrl: it is deprecated in TS 6 and stops functioning in 7.0.
    // "paths" resolves relative to this file's directory without it, and Vite
    // carries its own "@" alias, so runtime resolution is unaffected.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
